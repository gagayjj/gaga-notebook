{
  "name": "study-notes",
  "version": "0.1.0",
  "private": true,
  "description": "边看课边记笔记的本地桌面软件",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "mobile:serve": "node scripts/serve-mobile.cjs",
    "deploy:mobile": "npm run build && bash scripts/deploy-mobile-github.sh",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "electron ."
  },
  "dependencies": {
    "@tiptap/extension-color": "^2.27.3",
    "@tiptap/extension-highlight": "^2.27.3",
    "@tiptap/extension-image": "^2.27.3",
    "@tiptap/extension-placeholder": "^2.27.3",
    "@tiptap/extension-text-style": "^2.27.3",
    "@tiptap/extension-underline": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "fuse.js": "^7.0.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.42.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^33.2.1",
    "typescript": "^5.7.2",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  }
}
